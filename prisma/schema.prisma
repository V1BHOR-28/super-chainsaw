// ARIA — Autonomous Reasoning Intelligent Assistant
// Prisma schema — PostgreSQL (Neon) with pgvector for semantic search

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   // null for OAuth-only users (Google)
  image         String?   // profile picture URL (from Google OAuth)
  emailVerified DateTime? // null until email verification completes
  verifyCode    String?   // hashed 6-digit code
  verifyExpires DateTime? // when the code expires (15 min)
  // Onboarding (collected after first login)
  persona       String?   // "student" | "professional"
  age           Int?
  occupation    String?
  onboarded     Boolean   @default(false)
  // Existing fields
  tier          String    @default("Partner")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations   Conversation[]
  memories        Memory[]
  knowledge       Knowledge[]
  memoryDecisions MemoryDecision[]
  moods           Mood[]
  reminders       Reminder[]
  settings        UserSettings?
  usage           Usage[]
  dailyDigests    DailyDigest[]
  quotes          Quote[]
  audiobooks      Audiobook[]
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("New Conversation")
  userId    String
  pinned    Boolean  @default(false)
  summary            String?           // rolling summary of everything before the recent window
  summaryMessageCount Int    @default(0) // how many messages are already folded into `summary`
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  role            String   // "user" | "assistant" | "system"
  content         String
  attachmentsJson String?  // JSON string of attachment URLs / base64 refs
  toolUsed        String?  // "web_search" | "image_generation" | "vision" | null
  embedding       Unsupported("vector(768)")? // Gemini text-embedding-001 — for semantic conversation search
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Persistent memories — ARIA remembers facts about the user across all conversations
// Uses pgvector for semantic search (find relevant memories, not just recent ones)
model Memory {
  id        String   @id @default(cuid())
  userId    String
  content   String
  category  String   @default("general")
  pinned    Boolean  @default(false)
  source    String   @default("manual") // "manual" | "auto" — set by client, not user-editable after creation
  embedding Unsupported("vector(768)")? // Gemini text-embedding-004 dimension
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Knowledge base — user feeds ARIA articles, player lists, schedules, docs.
// ARIA uses semantic search (pgvector) to find relevant knowledge for each question.
model Knowledge {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String
  source     String   @default("text") // "text" | "url" | "file"
  sourceUrl  String?
  documentId String?                          // groups chunks of one document together
  finishedAt DateTime?
  embedding  Unsupported("vector(768)")? // Gemini text-embedding-004 dimension
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])                       // delete/lookup by document is now indexed
}

// Memory decisions — logs every Save/Skip so ARIA learns the user's pattern
model MemoryDecision {
  id            String   @id @default(cuid())
  userId        String
  candidateText String
  category      String   @default("general")
  accepted      Boolean
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Mood logs
model Mood {
  id        String   @id @default(cuid())
  userId    String
  mood      String   // "great" | "good" | "okay" | "low" | "rough"
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Reminders
model Reminder {
  id          String    @id @default(cuid())
  userId      String
  title       String
  dueAt       DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed, dueAt])
}

// Per-user ARIA settings
model UserSettings {
  userId           String   @id
  tone             String   @default("Warm & Honest")
  responseLength   String   @default("Balanced")
  modelPreference  String   @default("deepseek/deepseek-chat")
  soundEffects     Boolean  @default(true)
  localEncryption  Boolean  @default(true)
  trainingOptIn    Boolean  @default(false)
  autoDestruct     Boolean  @default(false)
  voiceEnabled     Boolean  @default(true)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActiveDate   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Daily token usage — one row per user per UTC day
model Usage {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  tokensUsed   Int      @default(0)
  requestCount Int      @default(0)
  knowledgeUploadCount Int @default(0) // per-UTC-day count of knowledge upload requests
  memoryWriteCount     Int @default(0) // per-UTC-day count of memory create requests
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// Daily digest — one per user per day, generated by Vercel Cron.
// A short "waiting for you" check-in built from recent mood + upcoming
// reminders + last conversation summary. App-visit-triggered, not push.
model DailyDigest {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Saved quotes — short, user-curated snippets meant to be referenced directly.
// Distinct from Knowledge (which is full-document ingestion for RAG).
model Quote {
  id        String   @id @default(cuid())
  userId    String
  text      String
  bookTitle String?
  author    String?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Audiobooks — auto-created when a user feeds ARIA book-length content.
// Links to Knowledge.documentId (the source text). Chapters are extracted
// from the PDF's TOC (outline) and stored as AudiobookChapter rows.
model Audiobook {
  id                 String   @id @default(cuid())
  userId             String
  documentId         String   // links to Knowledge.documentId — the source text
  title              String
  author             String?
  accent             String   @default("#f59e0b")
  fullText           String?  // complete untruncated source text (bypasses the 200K RAG cap)
  // Overall audiobook status — drives the UI's generation state.
  // PENDING → GENERATING (prep + TTS in progress) → COMPLETED (ready to play)
  //         → FAILED (something broke)
  status             String   @default("PENDING")
  // Resumable prep state — tracks progress across batched invocations so
  // the worker endpoint can resume from where the last call left off.
  chapterBoundaries  Json?    // result of pass A (chapter detection), stored so it never re-runs
  prepStatus         String   @default("pending") // pending | detecting | cleaning | ready | failed
  prepChaptersCleaned Int     @default(0) // how many chapters have completed pass B (cleaning) so far
  createdAt          DateTime @default(now())
  progressChapter    Int      @default(0)
  progressCharOffset Int      @default(0) // resume position within the chapter's text

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters AudiobookChapter[]

  @@index([userId, createdAt])
}

// Per-chapter data — one row per chapter extracted from the PDF's TOC.
// Each chapter has rawText (from PDF), cleanedText (after LLM cleaning),
// and an audioUrl (after TTS generation completes).
model AudiobookChapter {
  id              String   @id @default(cuid())
  audiobookId     String
  // Kept for backward compatibility with existing rows. New code uses chapterOrder.
  chapterIndex    Int      @default(0)
  // `chapterOrder` is the chapter's position in the book (0-indexed), derived
  // from the PDF's outline/TOC. Used for sorting and navigation.
  chapterOrder    Int      @default(0)
  title           String
  // Raw HTML content extracted from the EPUB spine for this chapter.
  rawHtml         String   @default("")
  // Raw text extracted from the HTML (tags stripped). Kept for debugging.
  rawText         String   @default("")
  // Narration-ready text after LLM cleaning (strips page numbers, headers,
  // footers, fixes hyphenated words). Falls back to rawText if cleaning fails.
  cleanedText     String   @default("")
  // TTS generation status for this chapter: pending | generating | ready | failed
  status          String   @default("pending")
  // URL of the generated MP3 audio file. Null until generation completes.
  audioUrl        String?
  durationSeconds Int?
  createdAt       DateTime @default(now())

  audiobook Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@index([audiobookId])
}
