# ─── Database (Neon Postgres) ───
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── NextAuth ───
NEXTAUTH_SECRET=your-random-secret-here
# NEXTAUTH_URL is auto-detected on Vercel — don't set it

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Resend (email) ───
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# ─── LLM Providers ───
OPENROUTER_API_KEY=your-openrouter-api-key

# ─── Gemini (embeddings + LLM fallback) ───
GEMINI_API_KEY=your-gemini-api-key

# ─── Groq (LLM fallback — fast 8B model) ───
GROQ_API_KEY=your-groq-api-key

# ─── Web Search ───
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key

# ─── ElevenLabs (TTS — for future voice mode) ───
# ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ─── Admin emails (comma-separated, bypasses daily limits) ───
# ADMIN_EMAILS=admin@example.com

# ─── Cron secret (authorizes Vercel Cron to hit /api/cron/* endpoints) ───
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret-here

# ─── Dev-mode auth bypass (LOCAL TESTING ONLY — never set in production) ──
# Set to 1 to skip login entirely and boot straight into the audiobook
# workspace. The audiobook backend uses its own abm_cid cookie, so upload/
# generate/play all work without a user account. Useful for testing the
# Docker backend without setting up the database + Google OAuth.
# NEXT_PUBLIC_DEV_BYPASS_AUTH=1

# ═══════════════════════════════════════════════════════════════════════
# AUDIOBOOK BACKEND (Docker — mini-services/audiobook-maker/)
# ═══════════════════════════════════════════════════════════════════════
# These are read by the Flask backend. Set them in .env (docker-compose
# passes them to the container via env_file). All are optional unless marked
# REQUIRED — the app degrades gracefully without the optional ones.

# ─── Server ─────────────────────────────────────────────────────────────
ABM_PORT=5601
ABM_DATA_DIR=/app/data
ABM_UPLOAD_DIR=/app/data
PYTHONUNBUFFERED=1
# ABM_DEBUG=0
# ABM_JOB_RETENTION_SEC=64800        # 18h default
# ABM_MAX_TEXT_CHARS=1500000
# ABM_MAX_UPLOAD_MB=70

# ─── Storj / R2 / S3 (off-site backup sync — all optional) ─────────────
# When unset, storage_backend.is_enabled() returns False and the app runs
# local-only (no off-site sync). Generated audio lives on the Docker volume.
ABM_S3_ENDPOINT=
ABM_S3_ACCESS_KEY=
ABM_S3_SECRET_KEY=
ABM_S3_BUCKET=
ABM_S3_REGION=auto
# ABM_S3_KEY_PREFIX=
# ABM_S3_PRESIGN_TTL_SEC=21600

# ─── LLM (Groq — for text optimization + chapter summaries) ────────────
ABM_LLM_API_KEY=
ABM_LLM_API_BASE=https://api.groq.com/openai/v1
ABM_LLM_MODEL=llama-3.3-70b-versatile

# ─── Gemini TTS (premium voices — optional) ────────────────────────────
# ABM_GEMINI_BACKEND=apikey
# ABM_GEMINI_API_KEY=
# ABM_GEMINI_FREE_THRESHOLD_EUR=1000

# ─── Google Cloud TTS (Chirp3-HD — optional, paid) ─────────────────────
# ABM_GCP_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json
# ABM_GOOGLE_CREDENTIALS_FILE=/app/gcp-key.json
# ABM_GOOGLE_TTS_MONTHLY_LIMIT=1000000

# ─── Speechify TTS (optional) ──────────────────────────────────────────
# ABM_SPEECHIFY_API_KEY=

# ─── SMTP (completion emails — optional) ───────────────────────────────
# ABM_SMTP_HOST=
# ABM_SMTP_PORT=587
# ABM_SMTP_USER=
# ABM_SMTP_PASS=
# ABM_SMTP_FROM=

# ─── PayPal (payments — optional) ──────────────────────────────────────
# ABM_PAYPAL_CLIENT_ID=
# ABM_PAYPAL_SECRET=
# ABM_PAYPAL_MODE=sandbox

# ─── FCM push notifications (optional) ─────────────────────────────────
# ABM_FCM_CREDENTIALS_FILE=/app/fcm-creds.json

# ─── Admin ─────────────────────────────────────────────────────────────
# ABM_ADMIN_TOKEN=
# ABM_ADMIN_EMAIL=

# ─── Frontend → backend proxy (set on Vercel, not in backend .env) ─────
# ABM_SERVICE_URL=http://localhost:5601
# NEXT_PUBLIC_ABM_DIRECT_URL=http://localhost:5601
# ABM_ALLOWED_ORIGINS=http://localhost:3000

# ─── ngrok Tunnel (Stable Public URL for Vercel → Local Backend) ───
# Get your free authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
# Claim your free static domain at https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app


