# ─── Database (Neon Postgres) ───
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── NextAuth ───
NEXTAUTH_SECRET=your-random-secret-here
# NEXTAUTH_URL is auto-detected on Vercel — don't set it

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Resend (email) ───
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# ─── LLM Providers ───
OPENROUTER_API_KEY=your-openrouter-api-key

# ─── Gemini (embeddings + LLM fallback) ───
GEMINI_API_KEY=your-gemini-api-key

# ─── Groq (LLM fallback — fast 8B model) ───
GROQ_API_KEY=your-groq-api-key

# ─── Web Search ───
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key

# ─── ElevenLabs (TTS — for future voice mode) ───
# ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ─── Admin emails (comma-separated, bypasses daily limits) ───
# ADMIN_EMAILS=admin@example.com

# ─── Cron secret (authorizes Vercel Cron to hit /api/cron/* endpoints) ───
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret-here

# ─── Audiobook Maker (Render backend) ───
# Production URL of the Flask audiobook service. The Next.js /api/abm proxy
# forwards all audiobook requests here. Set this in Vercel for production.
# Example: https://aria-audiobook-service.onrender.com
ABM_SERVICE_URL=http://localhost:5601
