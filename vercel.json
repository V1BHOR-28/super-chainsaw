{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/chat/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/search/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/knowledge/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/knowledge/batch/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/memory/detect/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/auto-destruct",
      "schedule": "30 6 * * *"
    }
  ]
}
